# App
APP_NAME=pressao-api
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=sua-chave-secreta-aqui

# Database
DATABASE_URL=postgresql://pressao:pressao123@localhost:5432/pressao
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Keycloak SSO
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pressao
KEYCLOAK_CLIENT_ID=pressao-api
KEYCLOAK_CLIENT_SECRET=seu-secret
KEYCLOAK_ADMIN_URL=${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}

# Providers
SENDGRID_API_KEY=mock-key
SENDGRID_SANDBOX_MODE=true
# Chave pública ECDSA do Event Webhook (Settings > Mail Settings > Event Webhook)
SENDGRID_WEBHOOK_VERIFICATION_KEY=
# URL pública do endpoint (use ngrok em desenvolvimento)
SENDGRID_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/sendgrid
# Account SID (AC...) e Auth Token: Console Twilio > Account Info. O Auth Token valida a assinatura dos webhooks
TWILIO_ACCOUNT_SID=mock-sid
TWILIO_AUTH_TOKEN=mock-token
# API Key (SK...) usada nas chamadas à API do Twilio; vazia = usa o Auth Token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# true (ou credenciais mock-*): ligações em dry-run, andamento via /webhooks/telefone/simular
TWILIO_SANDBOX_MODE=true
# Fora do dry-run: URL pública https (ex.: ngrok) que o Twilio chama
TWILIO_WEBHOOK_URL=https://seu-dominio.ngrok-free.app/api/v1/webhooks/twilio
TELEFONE_TIMEOUT_TOQUE_SEG=30

# Monitoring
METRICS_ENABLED=true
LOG_LEVEL=INFO