# App
APP_NAME=pressao-api
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=sua-chave-secreta-aqui

# Database
DATABASE_URL=postgresql://pressao:pressao123@localhost:5432/pressao
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Keycloak SSO
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pressao
KEYCLOAK_CLIENT_ID=pressao-api
KEYCLOAK_CLIENT_SECRET=seu-secret
KEYCLOAK_ADMIN_URL=${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}

# Providers (Mock)
SENDGRID_API_KEY=mock-key
TWILIO_ACCOUNT_SID=mock-sid
TWILIO_AUTH_TOKEN=mock-token

# Monitoring
METRICS_ENABLED=true
LOG_LEVEL=INFO