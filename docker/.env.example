# WordPress Database
WORDPRESS_DB_NAME=pressao_db
WORDPRESS_DB_USER=pressao_user
WORDPRESS_DB_PASSWORD=secure_password_here
WORDPRESS_DB_ROOT_PASSWORD=root_secure_password_here

# WordPress Debug
WORDPRESS_DEBUG=true
WORDPRESS_DEBUG_LOG=true
WORDPRESS_DEBUG_DISPLAY=true
SCRIPT_DEBUG=true

# WordPress Config
WORDPRESS_TABLE_PREFIX=wp_

# Keycloak (para testes)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pressao
KEYCLOAK_CLIENT_ID=pressao-api
KEYCLOAK_CLIENT_SECRET=seu-keycloak-client-secret

# Pressao API (sua API)
PRESSAO_API_URL=http://host.docker.internal:3000/api
PRESSAO_CAMPAIGN_ID=default_campaign